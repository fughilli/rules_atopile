# Demonstrates PARAMETERISED stdlib part picking via the local picker:
# `Resistor` + a resistance/package is resolved to a real LCSC part offline.
#pragma experiment("BRIDGE_CONNECT")

import ElectricPower
import Resistor

module PickerDemo:
    power = new ElectricPower
    power.voltage = 3.3V +/- 5%

    r = new Resistor
    r.resistance = 150ohm +/- 5%
    r.package = "0402"

    power.vcc ~> r ~> power.gnd
