# enable the `~>` series-bridge operator used below
#pragma experiment("BRIDGE_CONNECT")

import ElectricPower
import Resistor
import LED

module IndicatorLed:
    """A reusable LED + series resistor indicator.

    Exposed as an `atopile_library` so other designs can reuse it via `deps`.
    Uses real LCSC parts (atopile 0.15.x picks by `lcsc_id`; footprints come from
    EasyEDA — reachable, and cached under `.ato` for offline `--frozen` rebuilds).
    """
    power = new ElectricPower
    resistor = new Resistor
    led = new LED

    # 150 Ω series resistor (~9 mA at 3.3 V through a ~2 V red LED).
    resistor.lcsc_id = "C25082"   # UNI-ROYAL 0402WGF1500TCE, 150 Ω 0402
    led.lcsc_id = "C2286"         # KT-0603R, red 0603 LED

    # hv -> resistor -> led(anode->cathode) -> lv
    power.hv ~> resistor ~> led ~> power.lv
